{
  "name": "@23blocks/angular",
  "version": "14.4.0",
  "description": "Angular bindings for 23blocks SDK - Injectable services with typed delegation to block APIs",
  "license": "MIT",
  "author": "23blocks <hello@23blocks.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/23blocks-OS/frontend-sdk.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/23blocks-OS/frontend-sdk/tree/main/packages/angular",
  "bugs": {
    "url": "https://github.com/23blocks-OS/frontend-sdk/issues"
  },
  "keywords": [
    "23blocks",
    "angular",
    "angular-services",
    "angular-sdk",
    "rxjs",
    "typed-delegation",
    "promise-based",
    "angular-authentication",
    "angular-http-client",
    "angular-backend",
    "angular-api-client",
    "angular-ecommerce",
    "angular-crm",
    "baas-angular",
    "typescript",
    "injectable-services"
  ],
  "type": "module",
  "main": "dist/fesm2022/23blocks-angular.mjs",
  "module": "dist/fesm2022/23blocks-angular.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "esm2022": "./dist/fesm2022/23blocks-angular.mjs",
      "esm": "./dist/fesm2022/23blocks-angular.mjs",
      "default": "./dist/fesm2022/23blocks-angular.mjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "!dist/package.json",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "nx": {
    "sourceRoot": "packages/angular/src",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "npx ng-packagr -p packages/angular/ng-package.json -c packages/angular/tsconfig.lib.json"
        }
      }
    }
  },
  "dependencies": {
    "@23blocks/contracts": ">=2.3.0",
    "@23blocks/transport-http": ">=3.3.0",
    "@23blocks/block-authentication": ">=6.5.0",
    "@23blocks/block-search": ">=4.4.0",
    "@23blocks/block-products": ">=3.6.0",
    "@23blocks/block-crm": ">=3.3.1",
    "@23blocks/block-content": ">=3.5.0",
    "@23blocks/block-geolocation": ">=3.6.0",
    "@23blocks/block-conversations": ">=3.5.0",
    "@23blocks/block-files": ">=3.6.0",
    "@23blocks/block-forms": ">=3.3.0",
    "@23blocks/block-assets": ">=3.3.0",
    "@23blocks/block-campaigns": ">=3.3.0",
    "@23blocks/block-company": ">=3.4.0",
    "@23blocks/block-rewards": ">=3.4.0",
    "@23blocks/block-sales": ">=5.1.0",
    "@23blocks/block-wallet": ">=3.3.0",
    "@23blocks/block-jarvis": ">=3.3.0",
    "@23blocks/block-onboarding": ">=3.3.0",
    "@23blocks/block-university": ">=3.6.0",
    "@23blocks/block-rag": ">=1.0.0",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "rxjs": ">=7.0.0"
  }
}
