{
  "name": "@23blocks/angular",
  "version": "6.5.16",
  "description": "Angular bindings for 23blocks SDK - Injectable services with RxJS Observables",
  "license": "MIT",
  "author": "23blocks <hello@23blocks.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/23blocks-OS/frontend-sdk.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/23blocks-OS/frontend-sdk/tree/main/packages/angular",
  "bugs": {
    "url": "https://github.com/23blocks-OS/frontend-sdk/issues"
  },
  "keywords": [
    "23blocks",
    "angular",
    "angular-services",
    "angular-sdk",
    "rxjs",
    "rxjs-observables",
    "angular-authentication",
    "angular-http-client",
    "angular-backend",
    "angular-api-client",
    "angular-ecommerce",
    "angular-crm",
    "baas-angular",
    "typescript",
    "injectable-services"
  ],
  "type": "module",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "nx": {
    "sourceRoot": "packages/angular/src",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "npx ng-packagr -p packages/angular/ng-package.json -c packages/angular/tsconfig.lib.json"
        }
      }
    }
  },
  "dependencies": {
    "@23blocks/contracts": "*",
    "@23blocks/transport-http": "*",
    "@23blocks/block-authentication": "*",
    "@23blocks/block-search": "*",
    "@23blocks/block-products": "*",
    "@23blocks/block-crm": "*",
    "@23blocks/block-content": "*",
    "@23blocks/block-geolocation": "*",
    "@23blocks/block-conversations": "*",
    "@23blocks/block-files": "*",
    "@23blocks/block-forms": "*",
    "@23blocks/block-assets": "*",
    "@23blocks/block-campaigns": "*",
    "@23blocks/block-company": "*",
    "@23blocks/block-rewards": "*",
    "@23blocks/block-sales": "*",
    "@23blocks/block-wallet": "*",
    "@23blocks/block-jarvis": "*",
    "@23blocks/block-onboarding": "*",
    "@23blocks/block-university": "*",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "rxjs": ">=7.0.0"
  }
}
