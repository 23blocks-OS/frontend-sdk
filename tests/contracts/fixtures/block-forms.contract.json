{
  "block": "block-forms",
  "description": "API contract for all 13 forms block services, derived from Rails strong params",
  "services": {
    "forms": {
      "endpoints": [
        {
          "operation": "list",
          "method": "GET",
          "path": "/forms"
        },
        {
          "operation": "get",
          "method": "GET",
          "path": "/forms/:uniqueId"
        },
        {
          "operation": "create",
          "method": "POST",
          "path": "/forms",
          "rootKey": "form",
          "fields": [
            "code", "name", "description", "form_type", "form_url", "form_domain",
            "form_fields", "only_once", "background_url", "content_url", "success_url",
            "error_url", "notify_slack", "success_notification_message",
            "error_notification_message", "send_confirmation_mail", "mail_template",
            "send_confirmation_sms", "sms_template", "send_admin_notification",
            "admin_notification_email", "admin_notification_template",
            "form_schema_unique_id", "require_otp_verification", "payload"
          ]
        },
        {
          "operation": "update",
          "method": "PUT",
          "path": "/forms/:uniqueId",
          "rootKey": "form",
          "fields": [
            "name", "description", "form_type", "status", "form_url", "form_domain",
            "form_fields", "only_once", "background_url", "content_url", "success_url",
            "error_url", "notify_slack", "success_notification_message",
            "error_notification_message", "send_confirmation_mail", "mail_template",
            "send_confirmation_sms", "sms_template", "send_admin_notification",
            "admin_notification_email", "admin_notification_template",
            "form_schema_unique_id", "require_otp_verification", "payload"
          ]
        },
        {
          "operation": "delete",
          "method": "DELETE",
          "path": "/forms/:uniqueId"
        }
      ]
    },
    "landings": {
      "endpoints": [
        {
          "operation": "list",
          "method": "GET",
          "path": "/landings/:formUniqueId/instances"
        },
        {
          "operation": "get",
          "method": "GET",
          "path": "/landings/:formUniqueId/instances/:uniqueId"
        },
        {
          "operation": "submit",
          "method": "POST",
          "path": "/landings/:formUniqueId/instances",
          "rootKey": "landing",
          "fields": [
            "email", "first_name", "middle_name", "last_name", "phone_number",
            "message", "notes", "selected_option", "form_fields",
            "source", "source_alias", "source_id", "source_type",
            "visitor_unique_id", "visitor_type", "touch_id", "touch_reference_id",
            "preferred_language"
          ]
        },
        {
          "operation": "update",
          "method": "PUT",
          "path": "/landings/:formUniqueId/instances/:uniqueId",
          "rootKey": "landing",
          "fields": [
            "email", "first_name", "middle_name", "last_name", "phone_number",
            "message", "notes", "selected_option", "form_fields",
            "source", "source_alias", "source_id", "source_type",
            "visitor_unique_id", "visitor_type", "touch_id", "touch_reference_id",
            "preferred_language", "status"
          ]
        },
        {
          "operation": "delete",
          "method": "DELETE",
          "path": "/landings/:formUniqueId/instances/:uniqueId"
        }
      ]
    },
    "subscriptions": {
      "endpoints": [
